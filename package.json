{
  "name": "csharp-flow-visualizer",
  "displayName": "C# Flow Visualizer",
  "description": "Visualize C# code structure in a flowchart style",
  "version": "0.0.6",
  "license": "MIT",
  "author": {
    "name": "Christine Bell"
  },
  "contributors": [
    {
      "name": "Andreas Bilke",
      "email": "andreas.bilke@fh-salzburg.ac.at"
    }
  ],
  "publisher": "fhs-ct",
  "icon": "./icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/FHS-Creative-Technologies/csharpflowvizualizer"
  },
  "engines": {
    "vscode": "^1.108.1"
  },
  "files": [
    "out/**",
    "analyzer-dist/**",
    "web/dist/**",
    "icon.png",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "categories": [
    "Visualization",
    "Programming Languages"
  ],
  "keywords": [
    "csharp",
    "c#",
    "flowchart",
    "code structure",
    "graph"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "csharpFlowVisualizer.open",
        "category": "C# Flow Visualizer",
        "title": "Open Visualizer"
      }
    ]
  },
  "scripts": {
    "postinstall": "npm --prefix ./web install",
    "build:web": "npm --prefix ./web run build",
    "build:analyzer": "node ./scripts/build-analyzer.mjs",
    "licenses": "node ./scripts/generate-third-party-licenses.mjs",
    "vscode:prepublish": "npm run build:web && npm run build:analyzer && npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.13",
    "@types/vscode": "^1.108.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0"
  }
}