{
  "name": "csharpvisualizer",
  "displayName": "C# Visualizer",
  "description": "",
  "version": "0.0.5",
  "license": "MIT",
  "publisher": "ChristineBell",
  "icon": "./icon.png",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@gitlab.ct.fh-salzburg.ac.at/fhs50537/bachelorarbeit.git"
  },
  "engines": {
    "vscode": "^1.108.1"
  },
  "files": [
    "out/**",
    "analyzer-dist/**",
    "web/dist/**",
    "icon.png",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "csharpvisualizer.webview",
        "title": "csharpvisualizer: Open C# Visualizer"
      }
    ]
  },
  "scripts": {
    "build:web": "npm --prefix ./web run build",
    "build:analyzer": "node ./scripts/build-analyzer.mjs",
    "vscode:prepublish": "npm run build:web && npm run build:analyzer && npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.13",
    "@types/vscode": "^1.108.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0"
  }
}